{
  "expo": {
    "name": "ORÁCULO",
    "slug": "svin",
    "description": "ORÁCULO — plataforma privada para documentação, análise e gestão auditável de casos.",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F2F5F9",
    "scheme": "oraculo",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a6a5480c-3263-477a-8e8c-80bc17423104",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fireteam.vigia"
    },
    "android": {
      "package": "com.fireteam.vigia",
      "versionCode": 7,
      "adaptiveIcon": {
        "backgroundColor": "#1B4B8F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDxc5UQOsgWKs-G2ilKiHFubZbWjszHK4c"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "O ORÁCULO usa a galeria somente quando você decide anexar fotos ou vídeos a um caso.",
          "cameraPermission": "O ORÁCULO usa a câmera somente quando você decide registrar uma evidência."
        }
      ],
      "expo-audio",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O ORÁCULO usa localização para registrar a trilha de campo do operativo e para alertar sobre proximidade de pontos de interesse ligados aos seus casos.",
          "locationWhenInUsePermission": "O ORÁCULO usa localização para registrar a trilha de campo do operativo e marcar onde as evidências foram capturadas.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "O ORÁCULO acessa a galeria para localizar o arquivo original depois de anexar uma evidência.",
          "savePhotosPermission": "O ORÁCULO não salva fotos na galeria.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-foreground.png",
          "color": "#1B4B8F"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a6a5480c-3263-477a-8e8c-80bc17423104"
      }
    },
    "sdkVersion": "57.0.0",
    "platforms": [
      "ios",
      "android",
      "web"
    ]
  }
}
